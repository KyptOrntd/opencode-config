{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "new-api/Qwen3.8-Flash",
  "agent": {
    "title": {
      "model": "new-api/DeepSeek-V4-Flash",
      "options": {
        "reasoningEffort": "none",
      },
    },
  },
  "autoupdate": "notify",
  "provider": {
    "new-api": {
      "name": "New API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://47.120.57.242:3000/v1",
